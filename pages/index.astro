---
import PageLayout from "blume/components/layout/PageLayout.astro";
import Icon from "blume/components/Icon.astro";
import data from "blume:data";
import "@fontsource-variable/archivo/wdth.css";
import "./_home/home.css";
import "./_home/scene.css";
import "./_home/canvas.css";
import Hero from "./_home/Hero.astro";
import How from "./_home/How.astro";
import Again from "./_home/Again.astro";
import Compare from "./_home/Compare.astro";
import Kit from "./_home/Kit.astro";
import Shapes from "./_home/Shapes.astro";
import Local from "./_home/Local.astro";
import Download from "./_home/Download.astro";
import Footer from "./_home/Footer.astro";
import Frame from "./_home/Frame.astro";
import { ports, specs } from "./_home/ports";

const { config } = data;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  structuredDataEnabled={config.structuredData}
  transparentHeader
  page={{
    title: "Opsis: product demos that film themselves",
    description:
      "Opsis drives your real website or terminal, records it in one take and cuts it into a finished film. Export every shape at once, and press Run again when the product changes.",
    route: "/",
  }}
>
  <div class="ox" data-home>
    <Hero />
    <How />

    <div class="cv-start" aria-hidden="true" style={`--p: ${ports.browser.color}`}>
      <span class="cv-node" style={`--c: ${specs.open.color}`}>
        <span class="cv-badge"><Icon name={specs.open.icon} size={11} /></span>
        {specs.open.title}
        <i class="cv-start-out" data-start-out></i>
      </span>
      <span class="ox-mono">and the actions after it</span>
    </div>

    <Frame id="record">
      <Again />
    </Frame>

    <Frame id="clip">
      <Compare />
    </Frame>

    <Frame id="sequence">
      <Kit />
    </Frame>

    <Frame id="export">
      <Shapes />
    </Frame>

    <Frame id="note" class="fr-note" aside="Not part of the video" state="">
      <Local />
    </Frame>

    <Download />
  </div>
  <Footer slot="footer" />
</PageLayout>

<script>
  import { start } from "./_home/home";
  start();
</script>
