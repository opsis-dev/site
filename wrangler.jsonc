{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opsis-site",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "opsis.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
