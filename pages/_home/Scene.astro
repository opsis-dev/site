---
export type Shape = "16:9" | "9:16" | "1:1" | "4:5";
export type Mode = "raw" | "directed" | "film";

interface Props {
  shape?: Shape;
  mode?: Mode;
  design?: "a" | "b";
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const { shape = "16:9", mode = "film", design = "a", class: className, ...rest } = Astro.props;
const sizes: Record<Shape, [number, number]> = {
  "16:9": [1280, 720],
  "9:16": [720, 1280],
  "1:1": [960, 960],
  "4:5": [880, 1100],
};
const [w, h] = sizes[shape];

const nav = [52, 0, 64, 44, 58];
const rows = [
  { name: 46, pill: "a", meter: 72, people: 3 },
  { name: 62, pill: "b", meter: 41, people: 2 },
  { name: 38, pill: "a", meter: 88, people: 1 },
  { name: 54, pill: "c", meter: 23, people: 3 },
  { name: 44, pill: "b", meter: 64, people: 2 },
  { name: 58, pill: "a", meter: 52, people: 1 },
  { name: 36, pill: "c", meter: 12, people: 2 },
];
---

<div
  class:list={["sc", className]}
  style={`--w: ${w}; --h: ${h}`}
  data-shape={shape}
  data-mode={mode}
  data-design={design}
  data-w={w}
  data-h={h}
  aria-hidden="true"
  inert
  {...rest}
>
  <div class="sc-fit">
    <div class="sc-backdrop"></div>
    <div class="sc-cam" data-cam>
      <div class="sc-window" data-window>
        <div class="sc-bar">
          <span class="sc-lights"><i></i><i></i><i></i></span>
          <span class="sc-url">yourapp.com/projects</span>
        </div>
        <div class="sc-page">
          <div class="ap">
            <div class="ap-side">
              <div class="ap-brand"><i></i><b>Your app</b></div>
              <div class="ap-navs">
                {
                  nav.map((len) =>
                    len === 0 ? (
                      <span class="ap-nav is-on">
                        <i />
                        <b>Projects</b>
                      </span>
                    ) : (
                      <span class="ap-nav">
                        <i />
                        <u style={`width: ${len}%`} />
                      </span>
                    ),
                  )
                }
              </div>
              <div class="ap-user"><i></i><u></u></div>
            </div>
            <div class="ap-main">
              <div class="ap-head">
                <div class="ap-heading">
                  <b>Projects</b>
                  <span class="ap-count">
                    <span class="ap-roll"><i data-count-a>12</i><i data-count-b>13</i></span> active
                  </span>
                </div>
                <div class="ap-tools">
                  <span class="ap-search"><i></i><u></u></span>
                  <span class="ap-new" data-t="new">New project</span>
                </div>
              </div>
              <div class="ap-list">
                <div class="ap-row ap-fresh" data-fresh>
                  <i class="ap-dot" data-part></i>
                  <span class="ap-name" data-t="name" data-part>
                    <span data-typed></span><em data-caret></em>
                  </span>
                  <span class="ap-pill ap-pill-new" data-late>New</span>
                  <span class="ap-meter" data-late><i style="width: 4%"></i></span>
                  <span class="ap-people" data-late><i></i></span>
                  <span class="ap-share" data-t="share" data-late>
                    <span data-share-a>Share</span>
                    <span data-share-b>Link copied</span>
                  </span>
                </div>
                <div class="ap-rows" data-rows>
                  {
                    rows.map((row) => (
                      <div class="ap-row" data-row>
                        <i class="ap-dot" />
                        <span class="ap-name">
                          <u style={`width: ${row.name}%`} />
                        </span>
                        <span class={`ap-pill ap-pill-${row.pill}`}>
                          <u />
                        </span>
                        <span class="ap-meter">
                          <i style={`width: ${row.meter}%`} />
                        </span>
                        <span class="ap-people">
                          {Array.from({ length: row.people }, () => (
                            <i />
                          ))}
                        </span>
                        <span class="ap-share ap-ghost">
                          <u />
                        </span>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
            <div class="ap-toast" data-toast><i></i>Link copied to clipboard</div>
          </div>
        </div>
      </div>
      <div class="sc-ripple" data-ripple></div>
      <div class="sc-cursor" data-cursor>
        <svg viewBox="0 0 28 28" width="28" height="28">
          <path
            d="M5 3.5l16.2 9.1-7.3 1.9-3.6 6.9z"
            fill="#0b0b0e"
            stroke="#f5f5f8"
            stroke-width="1.8"
            stroke-linejoin="round"></path>
        </svg>
      </div>
    </div>

    <div class="sc-keys">
      <span class="sc-key" data-key>Enter<svg viewBox="0 0 24 24" width="18" height="18"><path d="M20 5v8a2 2 0 0 1-2 2H6m4-4-4 4 4 4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
    </div>

    <div class="sc-card sc-title" data-title>
      <span class="sc-eyebrow" data-title-eyebrow>A film about</span>
      <span class="sc-headline">
        <span class="sc-line"><span data-title-line>Your product,</span></span>
        <span class="sc-line"><span data-title-line>in one take.</span></span>
      </span>
      <i class="sc-edge" data-title-edge></i>
    </div>

    <div class="sc-card sc-end" data-end>
      <span class="sc-eyebrow" data-end-address>Made with</span>
      <span class="sc-headline sc-made">
        <span class="sc-line">
          <span data-end-line><img src="/logo.svg" alt="" />Opsis</span>
        </span>
      </span>
    </div>
  </div>
</div>
